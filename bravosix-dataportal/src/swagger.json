  "paths": {
    "/auth/signup": {
      "post": {
        "summary": "SignUp",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "username, password, email, firstname and lastname are required"
          },
          "409": {
            "description": "Username already exists"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "username": "userfour",
                "password": "123456",
                "email": "userfour@mail.com",
                "firstName": "User",
                "lastName": "Four"
              }
            }
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "SignIn",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Username and password are required"
          },
          "401": {
            "description": "Username or password does not match"
          },
          "500": {
            "description": "Internal Server Error"
